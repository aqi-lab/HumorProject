SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Vercel deployments receive VERCEL_OIDC_TOKEN automatically for AI Gateway.
# Add GEMINI_API_KEY for direct Gemini generation, or AI_GATEWAY_API_KEY for local AI Gateway use.
# Direct Gemini takes precedence when both are present.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides:
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
