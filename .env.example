SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Vercel deployments receive VERCEL_OIDC_TOKEN automatically for AI Gateway.
# Add GEMINI_API_KEY for direct Gemini generation, or AI_GATEWAY_API_KEY for local AI Gateway use.
# Optional backup providers. No provider key ever goes into browser code.
GROQ_API_KEY=your-groq-key
AI_PRIMARY_PROVIDER=groq
# OPENROUTER_API_KEY=your-openrouter-key
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides:
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Set false and redeploy to hide prompt reuse and reject old reuse submissions.
NEXT_PUBLIC_ENABLE_REMIX=true
# Image generation: Cloudflare's free daily allowance is preferred when configured.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-token
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
